---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { listAllScreenings } from '../../lib/api';

export const prerender = true;

// Static SHELL only: prerendered paths carry nothing but the screening id.
// Mutable seat availability and reservation state must NEVER be prerendered —
// the interactive seat map (Milestone 3) loads them at runtime in an island.
// Consequently, adding or removing screenings requires a rebuild to refresh
// these routes.
export async function getStaticPaths() {
  const apiUrl = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:3001';
  const screenings = await listAllScreenings(apiUrl);
  return screenings.map((screening) => ({
    params: { id: String(screening.id) },
    props: { screeningId: screening.id },
  }));
}

const { screeningId } = Astro.props;
---

<BaseLayout title={`Sessão ${screeningId}`}>
  <a
    href="/"
    class="font-mono text-xs uppercase tracking-widest text-white/50 transition-colors hover:text-white"
  >
    ← Voltar ao catálogo
  </a>

  <section aria-labelledby="sala-title" class="py-10">
    <p class="font-mono text-xs uppercase tracking-widest text-white/40">
      Sessão {screeningId} · em construção
    </p>
    <h1 id="sala-title" class="font-display mt-4 text-4xl font-black uppercase sm:text-5xl">
      Assentos<span class="text-ingresso">.</span>
    </h1>
    <p class="mt-4 max-w-xl text-white/70">
      O mapa de assentos interativo chega no Milestone 3, carregando disponibilidade direto da API
      em tempo real. Nenhum dado mutável foi pré-renderizado nesta página.
    </p>
  </section>
</BaseLayout>
