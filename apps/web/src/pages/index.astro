---
import BaseLayout from '../layouts/BaseLayout.astro';
import EmptyCatalog from '../components/EmptyCatalog.astro';
import MovieCard from '../components/MovieCard.astro';
import { listAllMovies } from '../lib/api';

export const prerender = true;

const apiUrl = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:3001';
// Throws on transport/shape failures: the build fails explicitly (adjustment 2).
const movies = await listAllMovies(apiUrl);
const years = movies.map((m) => m.releaseYear);
const span = movies.length > 0 ? `${Math.min(...years)}–${Math.max(...years)}` : 'sem dados';
---

<BaseLayout title="Filmes em cartaz" description="Catálogo de filmes — Ingresso, cinema fictício.">
  <p class="font-mono text-sm text-white/50">● REC — catálogo real, dados da API</p>
  <h1 class="font-display mt-4 text-5xl font-black uppercase tracking-tight sm:text-6xl">
    Em cartaz<span class="text-ingresso">.</span>
  </h1>
  <p class="mt-4 max-w-xl text-lg leading-relaxed text-white/70">
    {movies.length}
    {movies.length === 1 ? 'filme' : 'filmes'} · {span}. Escolha um filme para ver detalhes. Sessões
    e assentos chegam no Milestone 2.
  </p>

  {
    movies.length === 0 ? (
      <div class="mt-10">
        <EmptyCatalog />
      </div>
    ) : (
      <ul
        class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4"
        aria-label="Lista de filmes"
      >
        {movies.map((movie) => (
          <li>
            <MovieCard movie={movie} />
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>
