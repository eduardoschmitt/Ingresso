# Dependencies
node_modules/

# Build output
dist/
.astro/

# Test coverage
coverage/

# Environment files (never commit real secrets)
.env
.env.*
!.env.example
apps/*/.env
apps/*/.env.*

# Logs
*.log

# Load-test artifacts (regenerated per run; target.json holds run-local ids)
tests/load/target.json
tests/load/results/

# Playwright artifacts (traces, screenshots, reports per failed run)
test-results/
playwright-report/

# TMDB local cache (terms: cache <6 months, never redistribute via git).
# Renewed with `pnpm --filter @ingresso/web posters:sync [--force]`.
apps/web/public/posters/*.webp
apps/web/public/tmdb-logo.svg

# OS artifacts
.DS_Store
Thumbs.db

# Local agent instructions (referenced in docs, intentionally unpublished)
AGENTS.md
