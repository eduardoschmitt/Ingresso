# Ingresso — example environment.
# Copy to `.env` to customize local defaults. Never commit real secrets.
# Every variable below has a safe local default, so a zero-config run works
# without any `.env` file.

# PostgreSQL (used by docker-compose.yml interpolation)
POSTGRES_USER=ingresso
POSTGRES_PASSWORD=ingresso
POSTGRES_DB=ingresso
# Host port published by Compose. Change when 5432 is taken by another
# PostgreSQL on this machine (keep DATABASE_URL in sync).
DB_PORT=5432

# API (apps/api). The API also reads `apps/api/.env` (same keys); values
# below are the defaults used when no `.env` file is present.
NODE_ENV=development
HOST=0.0.0.0
PORT=3001
DATABASE_URL=postgres://ingresso:ingresso@localhost:5432/ingresso
# Browser origins allowed to read the API (comma-separated, no wildcard).
CORS_ORIGIN=http://localhost:4321
# Reservations: hold duration in minutes before an unpaid hold expires.
HOLD_MINUTES=5
# Safety for db:migrate / db:seed: hosts other than localhost are refused
# unless explicitly allowed here. Never set this against shared infrastructure
# without understanding which database will be migrated.
# INGRESSO_ALLOW_REMOTE_DB=1
# Integration tests: MUST be a dedicated database ending in `_test`.
# The test harness refuses to run against any other database name.
TEST_DATABASE_URL=postgres://ingresso:ingresso@localhost:5432/ingresso_test

# Load experiments (Phase 2): dedicated database ending in `_load`.
# The load harness refuses any other name. Keep ports in sync with DB_PORT.
LOAD_DATABASE_URL=postgres://ingresso:ingresso@localhost:5432/ingresso_load
# Load-test API instance port (dev instance stays on PORT).
LOAD_API_PORT=3002

# Monitoring (Phase 2, local only).
PROM_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
# REQUIRED, no default versioned (not even for development). Put a local-only
# value in your `.env` (gitignored, never commit). Compose fails fast without it.
# Example: GRAFANA_ADMIN_PASSWORD=<a local-only password>

# E2E tests (M5): dedicated database ingresso_e2e ONLY. The harness refuses
# any other name, including the dev database. Keep the host port in sync
# with DB_PORT. PUBLIC_API_URL must equal the e2e API URL at web build time
# (enforced by pretest:e2e; stale builds are rejected).
E2E_DATABASE_URL=postgres://ingresso:ingresso@localhost:5432/ingresso_e2e
E2E_API_PORT=3003
E2E_WEB_PORT=4323

# Web (apps/web, Astro). Must start with PUBLIC_ to reach client islands.
PUBLIC_API_URL=http://localhost:3001
# TMDB posters (apps/web only, local .env, NEVER commit or share).
# Personal key from https://www.themoviedb.org/settings/api — required only
# to run `posters:sync`. Without it the UI uses typographic fallbacks.
# TMDB_API_KEY=
