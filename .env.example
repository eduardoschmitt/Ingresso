# Ingresso — example environment.
# Copy to `.env` to customize local defaults. Never commit real secrets.
# Every variable below has a safe local default, so a zero-config run works
# without any `.env` file.

# PostgreSQL (used by docker-compose.yml interpolation)
POSTGRES_USER=ingresso
POSTGRES_PASSWORD=ingresso
POSTGRES_DB=ingresso
# Host port published by Compose. Change when 5432 is taken by another
# PostgreSQL on this machine (keep DATABASE_URL in sync).
DB_PORT=5432

# API (apps/api). The API also reads `apps/api/.env` (same keys); values
# below are the defaults used when no `.env` file is present.
NODE_ENV=development
HOST=0.0.0.0
PORT=3001
DATABASE_URL=postgres://ingresso:ingresso@localhost:5432/ingresso
# Reservations: hold duration in minutes before an unpaid hold expires.
HOLD_MINUTES=5
# Integration tests: MUST be a dedicated database ending in `_test`.
# The test harness refuses to run against any other database name.
TEST_DATABASE_URL=postgres://ingresso:ingresso@localhost:5432/ingresso_test

# Web (apps/web, Astro). Must start with PUBLIC_ to reach client islands.
PUBLIC_API_URL=http://localhost:3001
