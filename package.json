{
  "name": "ingresso",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:api": "pnpm --filter @ingresso/api dev",
    "dev:web": "pnpm --filter @ingresso/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "playwright test",
    "pretest:e2e": "node tests/e2e/prepare.mjs",
    "typecheck:e2e": "tsc --noEmit -p tests/e2e/tsconfig.json",
    "lint:e2e": "eslint tests/e2e playwright.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.0.0",
    "@types/pg": "8.23.1",
    "eslint": "^9.0.0",
    "eslint-plugin-astro": "^1.0.0",
    "globals": "^16.0.0",
    "pg": "8.23.1",
    "prettier": "^3.0.0",
    "prettier-plugin-astro": "^0.14.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  }
}
